rules_version = '2';

// EWOS-9 접근 제어 + EWOS-29 스키마 유효성 검증.
// 접근 제어(누가)에 더해, 클라이언트가 쓰는 문서의 형태(무엇을)까지 검증한다.
// 카페24 주문·상품·초대코드·토큰은 Functions(Admin SDK)가 규칙을 우회해 쓰므로
// 여기 검증은 앱에서 직접 오는 쓰기(발주 생성, fcmTokens, 거래처/상품 관리)에만 걸린다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOperator() {
      return isSignedIn() && userDoc().role == 'operator';
    }

    function myPartnerId() {
      return isSignedIn() ? userDoc().partnerId : null;
    }

    // 거래처 계정의 활성 상태(EWOS-29). 비활성(active=false) 거래처는 자기 데이터 접근이 차단된다.
    // 단, 자기 users·partners 문서 read는 앱이 '비활성 안내'를 띄우는 데 필요하므로 여기서 막지 않는다.
    function isActivePartner() {
      return isSignedIn()
        && myPartnerId() != null
        && get(/databases/$(database)/documents/partners/$(myPartnerId())).data.active == true;
    }

    // 길이 1 이상의 문자열인지.
    function isNonEmptyString(v) {
      return v is string && v.size() > 0;
    }

    // 거래처가 앱에서 생성하는 발주의 형태 검증.
    // 접근 제어(자기 partnerId)와 별개로, 위조·오염된 문서가 들어오는 것을 막는다.
    function isValidNewOrder() {
      let d = request.resource.data;
      return d.source == 'app'
        && d.status == 'new'
        && d.partnerId == myPartnerId()
        && isNonEmptyString(d.orderNo)
        && d.partnerName is string
        && d.items is list && d.items.size() > 0
        && d.totalAmount is int && d.totalAmount >= 0
        // 결제완료 주문은 Functions(createPaidOrder)만 만든다. 클라 위조 차단(EWOS-52).
        && d.paymentStatus == 'unpaid';
    }

    // 본인 문서만 read. 본인이 자기 fcmTokens(문자열 리스트)만 갱신하는 update는 허용하되,
    // role·partnerId·email 등 민감 필드 변경과 create/delete는 금지(위조 방지, Functions 전용).
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']) &&
        request.resource.data.fcmTokens is list;
      allow create, delete: if false;
    }

    // 운영자만 write. 해당 거래처 본인은 자기 문서 read + 자기 배송지(addresses)만 수정.
    // 생성 시 거래처명(필수)·active 형태를 검증한다. 삭제는 도메인상 없음(비활성화로 대체).
    match /partners/{partnerId} {
      allow read: if isOperator() || (isSignedIn() && myPartnerId() == partnerId);
      allow create: if isOperator() &&
        isNonEmptyString(request.resource.data.name) &&
        request.resource.data.active is bool;
      // 거래처 본인은 addresses 필드만 바꿀 수 있다(active·cafe24MemberId 등 변조 차단).
      allow update: if isOperator() ||
        (isSignedIn() && myPartnerId() == partnerId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['addresses']) &&
         request.resource.data.addresses is list);
      allow delete: if false;
    }

    // 로그인 사용자 read, 운영자만 write. 발주 가능 여부(enabled)는 불리언이어야 한다.
    // 상품 본문 생성/동기화는 Functions가 하므로 앱 쓰기는 사실상 enabled 토글뿐이다.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isOperator() && request.resource.data.enabled is bool;
    }

    // 거래처는 자기 발주만 read + create(형태 검증 포함).
    // 상태 변경(update)은 운영자 또는 '취소'를 원하는 거래처 본인.
    // 삭제는 금지(감사 이력 보존).
    match /orders/{orderId} {
      allow read: if isOperator() ||
        (resource.data.partnerId == myPartnerId() && isActivePartner()) ||
        (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isOperator() || (isValidNewOrder() && isActivePartner());
      allow update: if isOperator() || (
        isActivePartner() &&
        resource.data.partnerId == myPartnerId() &&
        resource.data.status in ['new', 'hold'] &&
        request.resource.data.status == 'canceled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history', 'updatedAt'])
      );
      allow delete: if false;
    }

    // 발주 즐겨찾기: 거래처가 자주 넣는 품목 묶음. 거래처 본인 것만 다룰 수 있다.
    // read는 운영자 또는 본인, create/update/delete는 본인만(역할 격리).
    // create 시 partnerId 위조 방지 + name 비어있지 않음 + items가 리스트인지 검증한다.
    match /favorites/{favId} {
      allow read: if isOperator() ||
        (resource.data.partnerId == myPartnerId() && isActivePartner());
      allow create: if isActivePartner() &&
        request.resource.data.partnerId == myPartnerId() &&
        isNonEmptyString(request.resource.data.name) &&
        request.resource.data.items is list;
      allow update, delete: if isActivePartner() &&
        resource.data.partnerId == myPartnerId();
    }

    // 정기발주(Standing Orders): 거래처가 설정한 자동 발주 스케줄.
    // 운영자는 모든 정기발주를 읽을 수 있고, 거래처 본인은 자신의 것만 읽고 쓰고 관리할 수 있다.
    match /standing_orders/{id} {
      allow read: if isOperator() ||
        (resource.data.partnerId == myPartnerId() && isActivePartner());
      allow create: if isActivePartner() &&
        request.resource.data.partnerId == myPartnerId() &&
        isNonEmptyString(request.resource.data.favoriteId) &&
        request.resource.data.cycle is map;
      allow update: if isActivePartner() &&
        resource.data.partnerId == myPartnerId() &&
        request.resource.data.partnerId == myPartnerId();
      allow delete: if isActivePartner() &&
        resource.data.partnerId == myPartnerId();
    }

    // 알림(Notifications): 푸시 알림 이력.
    // 본인에게 온 알림만 read 및 update(읽음 처리용) 가능. delete는 금지.
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false; // 생성은 서버(Functions)에서만.
    }

    // 초대 코드: 운영자는 현재 코드 조회만 가능. 발급·소진은 Functions(Admin) 전용이라
    // 클라이언트 write는 막는다(코드 위조·무단 소진 방지). 가입 검증도 미인증이라 Functions가 처리.
    match /inviteCodes/{code} {
      allow read: if isOperator();
      allow write: if false;
    }

    // 발주별 문의 채팅(Inquiries): 운영자와 해당 발주 거래처만 접근 가능.
    match /inquiries/{orderId} {
      function canAccessInquiry() {
        let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
        return isOperator() || (order.partnerId == myPartnerId() && isActivePartner());
      }
      allow read, write: if canAccessInquiry();

      match /messages/{messageId} {
        allow read, write: if canAccessInquiry();
      }
    }

    // 카페24 토큰 등 시크릿: 클라이언트 접근 전면 금지 (Functions Admin SDK 전용).
    match /secrets/{doc} {
      allow read, write: if false;
    }

    // 카페24 연동 상태(연결 여부·토큰 만료·동기화 시각). 시크릿은 없고 요약만 담긴다.
    // 운영자 상태 화면에서 read, 기록은 Functions 전용이라 write는 막는다.
    match /cafe24Status/{mallId} {
      allow read: if isOperator();
      allow write: if false;
    }

    // 앱 시작 게이트 설정(EWOS-42): 최소버전·점검 플래그. 미로그인 시작 시점에 읽어야 하므로
    // 이 문서만 공개 read 허용(민감정보 없음). write는 운영자 전용.
    match /settings/appConfig {
      allow read: if true;
      allow write: if isOperator();
    }

    // 전역 설정 (마감 시간 등). 운영자만 write 가능, 로그인 사용자는 read 가능.
    match /settings/{doc} {
      allow read: if isSignedIn();
      allow write: if isOperator();
    }
  }
}
